{
  "name": "fintube-client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "start": "npm run openapi:generate && ng serve --proxy-config src/proxy.conf.json",
    "build": "npm run openapi:generate && ng build",
    "openapi:generate": "openapi-generator-cli generate -i ../server/src/main/openapi/fintube.yaml -g typescript-angular -o src/app/api -c openapi-generator.json --skip-validate-spec",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeuix/themes": "^2.0.3",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.16",
    "@angular/cli": "^21.2.16",
    "@angular/compiler-cli": "^21.2.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2",
    "@openapitools/openapi-generator-cli": "^2.23.2"
  }
}
