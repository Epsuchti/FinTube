# Only needed when overriding the default runtime configuration.
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
# Optional: if omitted, FinTube creates data/setup-admin-token on first boot.
FINTUBE_SETUP_ADMIN_TOKEN=replace-with-a-long-random-one-time-token
# Use a long random value in production. Leaving it empty uses /data/settings.key.
FINTUBE_SETTINGS_KEY=
